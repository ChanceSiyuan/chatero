#!/bin/bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
APP_DIR="$(dirname "$SCRIPT_DIR")"
ROOT_DIR="$(dirname "$APP_DIR")"
SOURCE="$APP_DIR/assets/icons/chatero-app-icon.png"
OUTPUT="$APP_DIR/mac/Contents/Resources/AppIcon.icns"

if [ "$(uname -s)" != "Darwin" ]; then
	echo "Chatero macOS icons can only be generated on macOS" >&2
	exit 1
fi
if [ ! -f "$SOURCE" ]; then
	echo "Missing 1024px icon source: $SOURCE" >&2
	exit 1
fi

WIDTH=$(sips -g pixelWidth "$SOURCE" | /usr/bin/awk '/pixelWidth/ { print $2 }')
HEIGHT=$(sips -g pixelHeight "$SOURCE" | /usr/bin/awk '/pixelHeight/ { print $2 }')
if [ "$WIDTH" != "1024" ] || [ "$HEIGHT" != "1024" ]; then
	echo "Icon source must be exactly 1024x1024 (got ${WIDTH}x${HEIGHT})" >&2
	exit 1
fi

TEMP_DIR=$(mktemp -d "${TMPDIR:-/tmp}/chatero-icon.XXXXXX")
ICONSET="$TEMP_DIR/AppIcon.iconset"
trap 'rm -rf "$TEMP_DIR"' EXIT
mkdir "$ICONSET"

make_png() {
	local pixels="$1"
	local name="$2"
	sips -z "$pixels" "$pixels" "$SOURCE" --out "$ICONSET/$name" >/dev/null
}

make_png 16 icon_16x16.png
make_png 32 icon_16x16@2x.png
make_png 32 icon_32x32.png
make_png 64 icon_32x32@2x.png
make_png 128 icon_128x128.png
make_png 256 icon_128x128@2x.png
make_png 256 icon_256x256.png
make_png 512 icon_256x256@2x.png
make_png 512 icon_512x512.png
cp "$SOURCE" "$ICONSET/icon_512x512@2x.png"

iconutil -c icns "$ICONSET" -o "$OUTPUT"
printf '%s\n' "$OUTPUT"
