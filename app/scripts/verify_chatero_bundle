#!/bin/bash
set -euo pipefail

APP_BUNDLE="${1:-}"
if [ -z "$APP_BUNDLE" ] || [ ! -d "$APP_BUNDLE" ]; then
	echo "Usage: $0 path/to/Chatero.app" >&2
	exit 2
fi
APP_BUNDLE="$(cd "$APP_BUNDLE" && pwd -P)"

PLIST="$APP_BUNDLE/Contents/Info.plist"
APPLICATION_INI="$APP_BUNDLE/Contents/Resources/app/application.ini"
WORD_DYLIB="$APP_BUNDLE/Contents/Resources/integration/word-for-mac/libZoteroWordIntegration.dylib"
ENTITLEMENTS=$(mktemp)
cleanup() {
	cleanup_status=$?
	rm -f "$ENTITLEMENTS"
	exit "$cleanup_status"
}
trap cleanup EXIT

[ -f "$PLIST" ]
[ -f "$APPLICATION_INI" ]
[ -x "$APP_BUNDLE/Contents/MacOS/zotero" ]
[ -f "$WORD_DYLIB" ]

test "$(/usr/libexec/PlistBuddy -c 'Print :CFBundleName' "$PLIST")" = "Chatero"
test "$(/usr/libexec/PlistBuddy -c 'Print :CFBundleIdentifier' "$PLIST")" \
	= "io.github.chancesiyuan.chatero"
test "$(/usr/libexec/PlistBuddy -c 'Print :CFBundleURLTypes:0:CFBundleURLSchemes:0' "$PLIST")" \
	= "chatero"
/usr/bin/grep -qx 'Name=Chatero' "$APPLICATION_INI"
/usr/bin/grep -qx 'ID=zotero@zotero.org' "$APPLICATION_INI"
if /usr/bin/grep -q 'download/client/update' "$APPLICATION_INI"; then
	echo "Official Zotero updater URL must not be present" >&2
	exit 1
fi

/usr/bin/codesign --verify --deep --strict --verbose=2 "$APP_BUNDLE"
/usr/bin/codesign -d --entitlements "$ENTITLEMENTS" --xml "$WORD_DYLIB" 2>/dev/null
word_automation=$(/usr/libexec/PlistBuddy -c 'Print :com.apple.security.automation.apple-events' "$ENTITLEMENTS" 2>/dev/null || true)
if [ "$word_automation" != "true" ]; then
	echo "Word integration Apple Events entitlement missing after signing" >&2
	exit 1
fi
