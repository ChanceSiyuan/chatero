#!/bin/bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
APP_ROOT_DIR="$(dirname "$SCRIPT_DIR")"
ROOT_DIR="$(dirname "$APP_ROOT_DIR")"

TEST_MODE="${CHATER0_PACKAGE_TEST_MODE:-0}"
if [ "$TEST_MODE" = "1" ]; then
	APP_BUNDLE="${CHATER0_PACKAGE_TEST_APP_BUNDLE:?test app bundle is required}"
	DIST_DIR="${CHATER0_PACKAGE_TEST_DIST_DIR:?test dist directory is required}"
	VERSION_FILE="${CHATER0_PACKAGE_TEST_VERSION_FILE:?test version file is required}"
	PKG_DMG="${CHATER0_PACKAGE_TEST_PKG_DMG:?test pkg-dmg is required}"
	HDIUTIL="${CHATER0_PACKAGE_TEST_HDIUTIL:?test hdiutil is required}"
	SHASUM="${CHATER0_PACKAGE_TEST_SHASUM:?test shasum is required}"
	MOVE="${CHATER0_PACKAGE_TEST_MV:?test mv is required}"
	COPY="${CHATER0_PACKAGE_TEST_COPY:?test cp is required}"
	REMOVE="${CHATER0_PACKAGE_TEST_REMOVE:?test rm is required}"
	VERIFY="${CHATER0_PACKAGE_TEST_VERIFY:?test verifier is required}"
else
	. "$APP_ROOT_DIR/config.sh"
	APP_BUNDLE="$APP_ROOT_DIR/staging/$APP_NAME.app"
	DIST_DIR="$APP_ROOT_DIR/dist"
	VERSION_FILE="$ROOT_DIR/version"
	PKG_DMG="$APP_ROOT_DIR/mac/pkg-dmg"
	HDIUTIL="/usr/bin/hdiutil"
	SHASUM="/usr/bin/shasum"
	MOVE="/bin/mv"
	COPY="/bin/cp"
	REMOVE="/bin/rm"
	VERIFY="$SCRIPT_DIR/verify_chatero_bundle"
fi

if [ "$TEST_MODE" != "1" ] || [ "${CHATER0_PACKAGE_TEST_SKIP_BUILD:-0}" != "1" ]; then
	cd "$ROOT_DIR"
	if [ "$TEST_MODE" != "1" ]; then
		if [ -n "$(git status --short --untracked-files=no)" ]; then
			echo "Refusing to package a bundle from uncommitted tracked source changes" >&2
			exit 1
		fi
		node scripts/chatero/generate-product.mjs --build-provenance
	fi
	NODE_OPTIONS=--openssl-legacy-provider node js-build/build.js
	"$SCRIPT_DIR/dir_build" -f -p m
fi
if [ "$TEST_MODE" != "1" ] || [ "${CHATER0_PACKAGE_TEST_SKIP_BUNDLE_VERIFY:-0}" != "1" ]; then
	"$VERIFY" "$APP_BUNDLE"
fi

if ! VERSION=$(/usr/bin/perl -0777 -ne 'if (/\A([A-Za-z0-9][A-Za-z0-9._+-]*)(?:\n)?\z/) { print $1 } else { exit 1 }' "$VERSION_FILE"); then
	echo "Version file must be one safe token with at most one trailing LF: $VERSION_FILE" >&2
	exit 1
fi

mkdir -p "$DIST_DIR"
DMG="$DIST_DIR/Chatero-${VERSION}.dmg"
CHECKSUM="$DMG.sha256"
TEMP_DIR=$(mktemp -d "$DIST_DIR/.chatero-dmg.XXXXXX")
TEMP_DMG="$TEMP_DIR/$(basename "$DMG")"
TEMP_CHECKSUM="$TEMP_DIR/$(basename "$CHECKSUM")"
BACKUP_READY=0
PUBLICATION_STARTED=0
PUBLISHED=0
KEEP_TEMP=0

write_rebound_checksum() {
	local source_checksum="$1" artifact="$2" destination="$3"
	local line digest
	line=$(<"$source_checksum")
	digest="${line%% *}"
	[[ "$digest" =~ ^[0-9A-Fa-f]{64}$ ]] || return 1
	printf '%s  %s\n' "$digest" "$(basename "$artifact")" > "$destination"
}

validate_checksum_pair() {
	local artifact="$1" checksum_path="$2"
	local line digest filename
	[ -f "$artifact" ] && [ -f "$checksum_path" ] || return 1
	line=$(<"$checksum_path")
	digest="${line%% *}"
	filename="${line#"$digest"  }"
	[[ "$digest" =~ ^[0-9A-Fa-f]{64}$ ]] \
		&& [ "$line" = "$digest  $filename" ] \
		&& [ "$filename" = "$(basename "$artifact")" ] \
		&& (cd "$DIST_DIR" && "$SHASUM" -a 256 -c "$(basename "$checksum_path")")
}

discard_path() {
	local path="$1"
	[ ! -e "$path" ] || "$REMOVE" -f "$path" || /bin/rm -f "$path"
}

cleanup_incomplete_backup() {
	if [ -n "${PREVIOUS_CHECKSUM:-}" ]; then discard_path "$PREVIOUS_CHECKSUM" || true; fi
	if [ -n "${PREVIOUS_DMG:-}" ]; then discard_path "$PREVIOUS_DMG" || true; fi
}

backup_failure() {
	cleanup_incomplete_backup
	echo "Backup creation failed; existing final pair remains recoverable at $DMG and $CHECKSUM" >&2
}

create_verified_backup() {
	if [ ! -e "$DMG" ] && [ ! -e "$CHECKSUM" ]; then
		return 0
	fi
	if ! validate_checksum_pair "$DMG" "$CHECKSUM"; then
		echo "Existing DMG/checksum pair is incomplete, invalid, or not bound to $DMG" >&2
		return 1
	fi

	local suffix="$(date -u +%Y%m%dT%H%M%SZ).previous"
	PREVIOUS_DMG="$DMG.$suffix"
	PREVIOUS_CHECKSUM="$CHECKSUM.$suffix"
	local index=1
	while [ -e "$PREVIOUS_DMG" ] || [ -e "$PREVIOUS_CHECKSUM" ]; do
		PREVIOUS_DMG="$DMG.$suffix.$index"
		PREVIOUS_CHECKSUM="$CHECKSUM.$suffix.$index"
		index=$((index + 1))
	done

	if ! "$COPY" "$DMG" "$PREVIOUS_DMG"; then backup_failure; return 1; fi
	local backup_checksum="$TEMP_DIR/previous-checksum"
	if ! write_rebound_checksum "$CHECKSUM" "$PREVIOUS_DMG" "$backup_checksum"; then backup_failure; return 1; fi
	if ! "$MOVE" "$backup_checksum" "$PREVIOUS_CHECKSUM"; then backup_failure; return 1; fi
	if ! validate_checksum_pair "$PREVIOUS_DMG" "$PREVIOUS_CHECKSUM"; then backup_failure; return 1; fi
	BACKUP_READY=1
}

evacuate_final_outputs() {
	if [ -e "$CHECKSUM" ] && ! "$MOVE" "$CHECKSUM" "$TEMP_DIR/replaced-final-checksum"; then return 1; fi
	if [ -e "$DMG" ] && ! "$MOVE" "$DMG" "$TEMP_DIR/replaced-final-dmg"; then return 1; fi
}

restore_final_from_backup() {
	[ "$BACKUP_READY" = "1" ] || return 0
	local restored_dmg="$TEMP_DIR/restored-final-dmg"
	local restored_checksum="$TEMP_DIR/restored-final-checksum"
	if ! "$COPY" "$PREVIOUS_DMG" "$restored_dmg"; then
		KEEP_TEMP=1
		echo "FATAL: final restoration failed; valid recovery pair remains at $PREVIOUS_DMG and $PREVIOUS_CHECKSUM" >&2
		return 1
	fi
	if ! write_rebound_checksum "$PREVIOUS_CHECKSUM" "$DMG" "$restored_checksum"; then
		KEEP_TEMP=1
		echo "FATAL: final restoration checksum failed; valid recovery pair remains at $PREVIOUS_DMG and $PREVIOUS_CHECKSUM" >&2
		return 1
	fi
	if ! "$MOVE" "$restored_dmg" "$DMG" || ! "$MOVE" "$restored_checksum" "$CHECKSUM"; then
		KEEP_TEMP=1
		discard_path "$CHECKSUM" || true
		discard_path "$DMG" || true
		echo "FATAL: final restoration move failed; valid recovery pair remains at $PREVIOUS_DMG and $PREVIOUS_CHECKSUM" >&2
		return 1
	fi
	if ! validate_checksum_pair "$DMG" "$CHECKSUM"; then
		KEEP_TEMP=1
		echo "FATAL: restored final pair did not verify; valid recovery pair remains at $PREVIOUS_DMG and $PREVIOUS_CHECKSUM" >&2
		return 1
	fi
}

cleanup() {
	local cleanup_status=$?
	trap - EXIT
	if [ "$PUBLISHED" != "1" ]; then
		if [ "$PUBLICATION_STARTED" = "1" ]; then
			discard_path "$CHECKSUM" || cleanup_status=1
			discard_path "$DMG" || cleanup_status=1
			if [ "$BACKUP_READY" = "1" ]; then
				restore_final_from_backup || cleanup_status=1
			fi
		else
			cleanup_incomplete_backup
		fi
	fi
	if [ "$KEEP_TEMP" = "0" ]; then
		/bin/rm -rf "$TEMP_DIR"
	fi
	exit "$cleanup_status"
}
trap cleanup EXIT

"$PKG_DMG" \
	--source "$APP_BUNDLE" \
	--target "$TEMP_DMG" \
	--sourcefile \
	--volname "Chatero" \
	--copy "$APP_ROOT_DIR/mac/DSStore:/.DS_Store" \
	--symlink /Applications:"/Drag Here to Install"

"$HDIUTIL" verify "$TEMP_DMG"
"$SHASUM" -a 256 "$TEMP_DMG" | /usr/bin/awk -v name="$(basename "$DMG")" '{ print $1 "  " name }' > "$TEMP_CHECKSUM"

create_verified_backup
PUBLICATION_STARTED=1
evacuate_final_outputs
if ! "$MOVE" "$TEMP_DMG" "$DMG"; then
	echo "Unable to publish DMG; restoring final from verified backup" >&2
	exit 1
fi
if ! "$MOVE" "$TEMP_CHECKSUM" "$CHECKSUM"; then
	echo "Unable to publish DMG checksum; restoring final from verified backup" >&2
	exit 1
fi
if ! validate_checksum_pair "$DMG" "$CHECKSUM"; then
	echo "Published DMG/checksum pair failed final verification" >&2
	exit 1
fi
PUBLISHED=1
printf '%s\n' "$DMG"
