#!/bin/bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
APP_ROOT_DIR="$(dirname "$SCRIPT_DIR")"
ROOT_DIR="$(dirname "$APP_ROOT_DIR")"
. "$APP_ROOT_DIR/config.sh"

cd "$ROOT_DIR"
NODE_OPTIONS=--openssl-legacy-provider node js-build/build.js
"$SCRIPT_DIR/dir_build" -f -p m

APP_BUNDLE="$APP_ROOT_DIR/staging/$APP_NAME.app"
"$SCRIPT_DIR/verify_chatero_bundle" "$APP_BUNDLE"

VERSION="$(tr -d '\\r\\n' < "$ROOT_DIR/version")"
DIST_DIR="$APP_ROOT_DIR/dist"
mkdir -p "$DIST_DIR"
DMG="$DIST_DIR/Chatero-${VERSION}.dmg"
CHECKSUM="$DMG.sha256"
TEMP_DIR=$(mktemp -d "$DIST_DIR/.chatero-dmg.XXXXXX")
TEMP_DMG="$TEMP_DIR/Chatero-${VERSION}.dmg"
TEMP_CHECKSUM="$TEMP_DIR/Chatero-${VERSION}.dmg.sha256"
cleanup() {
	cleanup_status=$?
	rm -rf "$TEMP_DIR"
	exit "$cleanup_status"
}
trap cleanup EXIT

rotate_existing_artifacts() {
	if [ ! -e "$DMG" ] && [ ! -e "$CHECKSUM" ]; then
		return
	fi
	if [ ! -f "$DMG" ] || [ ! -f "$CHECKSUM" ]; then
		echo "Existing DMG and checksum must be a complete pair: $DMG" >&2
		exit 1
	fi
	if ! (cd "$DIST_DIR" && shasum -a 256 -c "$(basename "$CHECKSUM")"); then
		echo "Existing DMG checksum is invalid; refusing to replace it" >&2
		exit 1
	fi

	local suffix="$(date -u +%Y%m%dT%H%M%SZ).previous"
	local previous_dmg="$DMG.$suffix"
	local previous_checksum="$CHECKSUM.$suffix"
	local index=1
	while [ -e "$previous_dmg" ] || [ -e "$previous_checksum" ]; do
		previous_dmg="$DMG.$suffix.$index"
		previous_checksum="$CHECKSUM.$suffix.$index"
		index=$((index + 1))
	done

	mv "$DMG" "$previous_dmg"
	if ! mv "$CHECKSUM" "$previous_checksum"; then
		mv "$previous_dmg" "$DMG"
		echo "Unable to rotate existing DMG checksum" >&2
		exit 1
	fi
	PREVIOUS_DMG="$previous_dmg"
	PREVIOUS_CHECKSUM="$previous_checksum"
}

restore_previous_artifacts() {
	if [ -n "${PREVIOUS_DMG:-}" ]; then
		mv "$PREVIOUS_DMG" "$DMG"
		mv "$PREVIOUS_CHECKSUM" "$CHECKSUM"
	fi
}

"$APP_ROOT_DIR/mac/pkg-dmg" \
	--source "$APP_BUNDLE" \
	--target "$TEMP_DMG" \
	--sourcefile \
	--volname "Chatero" \
	--copy "$APP_ROOT_DIR/mac/DSStore:/.DS_Store" \
	--symlink /Applications:"/Drag Here to Install"

hdiutil verify "$TEMP_DMG"
# Write the eventual filename so `shasum -c Chatero-*.dmg.sha256` works after publishing.
shasum -a 256 "$TEMP_DMG" | /usr/bin/awk -v dmg="$DMG" '{ print $1 "  " dmg }' > "$TEMP_CHECKSUM"

rotate_existing_artifacts
mv "$TEMP_DMG" "$DMG"
if ! mv "$TEMP_CHECKSUM" "$CHECKSUM"; then
	mv "$DMG" "$TEMP_DMG"
	restore_previous_artifacts
	echo "Unable to publish DMG checksum; previous artifacts restored" >&2
	exit 1
fi
printf '%s\\n' "$DMG"
