{
  "name": "zotero",
  "private": true,
  "version": "7.0.0",
  "description": "Zotero",
  "main": "",
  "scripts": {
    "start": "node ./js-build/build.js && node ./js-build/watch.js",
    "build": "node ./scripts/chatero/generate-product.mjs --build-provenance && node ./js-build/build.js",
    "sass": "node ./js-build/sass.js",
    "js": "node ./js-build/js.js",
    "clean": "node ./js-build/clean.js",
    "ftl-to-json": "node ./js-build/ftl-to-json.mjs",
    "localize-ftl": "node ./js-build/localize-ftl.mjs",
    "clean-build": "node ./js-build/clean.js && node ./js-build/build.js",
    "clean-start": "node ./js-build/clean.js && node ./js-build/build.js && node ./js-build/watch.js",
    "build:qlab-starter": "node ./scripts/chatero/build-qlab-starter.mjs",
    "test:chatero": "node --test scripts/chatero/tests/*.test.mjs",
    "build:documentation-webview": "node products/workbench/scripts/build-documentation-webview.mjs",
    "test:workbench-bootstrap": "npm run build:documentation-webview && node products/workbench/scripts/run-node-tests.mjs products/workbench/tests/*.test.mjs",
    "test:documentation": "npm run build:documentation-webview && node products/workbench/scripts/run-node-tests.mjs products/workbench/tests/documentation-*.test.mjs",
    "test:documentation:integration": "npm run build:documentation-webview && node products/workbench/scripts/run-documentation-integration.mjs",
    "test:remote-agent": "npm run build:documentation-webview && node products/workbench/scripts/run-node-tests.mjs products/workbench/tests/remote-agent-*.test.mjs",
    "core:generate": "node services/zotero-core/scripts/generate-protocol.mjs",
    "core:check": "node services/zotero-core/scripts/generate-protocol.mjs --check",
    "test:zotero-core": "node --test services/zotero-core/tests/*.test.mjs",
    "workbench:bootstrap": "node products/workbench/scripts/bootstrap-code-oss.mjs",
    "workbench:compile": "node products/workbench/scripts/run-code-oss.mjs --compile",
    "workbench:dev": "node products/workbench/scripts/run-code-oss.mjs --launch",
    "workbench:install": "node products/workbench/scripts/run-code-oss.mjs --install",
    "workbench:verify": "node products/workbench/scripts/verify-code-oss.mjs",
    "remote-agent:stage": "node products/workbench/remote-agent/scripts/stage-release.mjs",
    "package:chatero": "app/scripts/package_chatero_dmg",
    "verify:chatero-bundle": "app/scripts/verify_chatero_bundle app/staging/Chatero.app",
    "verify:workbench-bootstrap": "npm run test:workbench-bootstrap && npm run workbench:verify",
    "verify:stage-1": "node products/workbench/scripts/run-stage-1-acceptance.mjs",
    "verify:stage-2": "node services/zotero-core/scripts/run-stage-2-acceptance.mjs",
    "verify:stage-3": "node products/workbench/scripts/run-stage-3-acceptance.mjs",
    "verify:stage-4": "node products/workbench/scripts/run-stage-4-acceptance.mjs",
    "verify:stage-5": "node products/workbench/scripts/run-stage-5-acceptance.mjs",
    "verify:stage-6": "node products/workbench/scripts/run-stage-6-acceptance.mjs",
    "test:chatero:staged": "app/scripts/verify_chatero_bundle app/staging/Chatero.app"
  },
  "license": "",
  "dependencies": {
    "@citeproc-rs/wasm": "^0.2.0",
    "ace-builds": "^1.4.12",
    "classnames": "^2.2.6",
    "csl-validator-wasm": "^1.0.0",
    "katex": "0.16.22",
    "monaco-editor": "^0.47.0",
    "monacopilot": "^1.1.15",
    "prop-types": "^15.8.0",
    "react": "^18.3.1",
    "react-autosuggest": "^10.1.0",
    "react-dom": "^18.3.1",
    "react-intl": "^3.4.0",
    "react-select": "^3.0.8",
    "url": "^0.11.0",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@babel/cli": "^7.26.4",
    "@babel/core": "^7.26.0",
    "@babel/eslint-parser": "^7.25.9",
    "@babel/eslint-plugin": "^7.25.9",
    "@babel/preset-react": "^7.26.3",
    "@codemirror/commands": "6.10.4",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/language": "6.12.4",
    "@codemirror/state": "6.7.1",
    "@codemirror/view": "6.43.8",
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.17.0",
    "@lezer/markdown": "1.7.2",
    "@zotero/eslint-config": "^1.0.8",
    "acorn": "8.15.0",
    "babel-plugin-transform-es2015-modules-commonjs": "^6.26.2",
    "browserify": "^14.5.0",
    "chai": "^4.1.2",
    "chokidar": "^2.1.2",
    "co-mocha": "^1.2.1",
    "colors": "^1.4.0",
    "esbuild": "0.28.2",
    "eslint": "^9.17.0",
    "eslint-plugin-react": "^7.37.3",
    "eslint-plugin-react-hooks": "^5.1.0",
    "fs-extra": "^3.0.1",
    "ftl-tx": "^0.17.0",
    "globals": "^15.14.0",
    "globby": "^6.1.0",
    "jspath": "^0.4.0",
    "mocha": "^10.4.0",
    "multimatch": "^2.1.0",
    "pako": "^2.1.0",
    "react-virtualized": "^9.22.4",
    "sass": "^1.69.5",
    "sinon": "^7.3.2",
    "universalify": "^0.1.1"
  }
}
