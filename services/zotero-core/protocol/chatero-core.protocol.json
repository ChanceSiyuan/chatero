{
  "schemaVersion": 1,
  "protocolVersion": "1.0",
  "maxFrameBytes": 1048576,
  "defaultDeadlineMs": 5000,
  "capabilities": [
    "events:read",
    "library:read",
    "library:search",
    "profile:read"
  ],
  "methods": [
    {
      "name": "core.cancel",
      "capability": null,
      "paramsType": "CoreCancelParams",
      "resultType": "CoreCancelResult"
    },
    {
      "name": "core.handshake",
      "capability": null,
      "paramsType": "CoreHandshakeParams",
      "resultType": "CoreHandshakeResult"
    },
    {
      "name": "profile.status",
      "capability": "profile:read",
      "paramsType": "ProfileStatusParams",
      "resultType": "ProfileStatusResult"
    },
    {
      "name": "library.collections",
      "capability": "library:read",
      "paramsType": "LibraryCollectionsParams",
      "resultType": "LibraryCollectionsResult"
    },
    {
      "name": "library.item-children",
      "capability": "library:read",
      "paramsType": "LibraryItemChildrenParams",
      "resultType": "LibraryItemChildrenResult"
    },
    {
      "name": "library.item-metadata",
      "capability": "library:read",
      "paramsType": "LibraryItemMetadataParams",
      "resultType": "LibraryItemMetadata"
    },
    {
      "name": "library.annotations",
      "capability": "library:read",
      "paramsType": "LibraryAnnotationsParams",
      "resultType": "LibraryAnnotationsResult"
    },
    {
      "name": "library.attachment",
      "capability": "library:read",
      "paramsType": "LibraryAttachmentParams",
      "resultType": "LibraryAttachmentSummary"
    },
    {
      "name": "library.note",
      "capability": "library:read",
      "paramsType": "LibraryNoteParams",
      "resultType": "LibraryNoteResult"
    },
    {
      "name": "library.search",
      "capability": "library:search",
      "paramsType": "LibrarySearchParams",
      "resultType": "LibrarySearchResult"
    }
  ],
  "types": {
    "CoreCancelParams": {
      "kind": "object",
      "fields": {
        "cancellationId": "string"
      }
    },
    "CoreCancelResult": {
      "kind": "object",
      "fields": {
        "cancelled": "boolean"
      }
    },
    "CoreHandshakeParams": {
      "kind": "object",
      "fields": {
        "bootstrapToken": "string",
        "protocolVersion": "string",
        "requestedCapabilities": "string[]"
      }
    },
    "CoreHandshakeResult": {
      "kind": "object",
      "fields": {
        "capabilities": "string[]",
        "expiresAt": "number",
        "profileEpoch": "string",
        "protocolVersion": "string",
        "sessionToken": "string",
        "upstreamVersion": "string"
      }
    },
    "ProfileStatusParams": {
      "kind": "object",
      "fields": {}
    },
    "ProfileStatusResult": {
      "kind": "object",
      "fields": {
        "profileEpoch": "string",
        "profileName": "string",
        "readOnly": "boolean",
        "schemaVersion": "number",
        "upstreamVersion": "string"
      }
    },
    "LibrarySearchParams": {
      "kind": "object",
      "fields": {
        "collectionKey?": "string",
        "cursor?": "string",
        "libraryId?": "number",
        "limit": "number",
        "query": "string"
      }
    },
    "LibraryItemSummary": {
      "kind": "object",
      "fields": {
        "attachmentCount": "number",
        "collectionKeys?": "string[]",
        "creators": "string[]",
        "itemKey": "string",
        "itemType": "string",
        "libraryId": "number",
        "title": "string",
        "year?": "number"
      }
    },
    "LibraryCollectionSummary": {
      "kind": "object",
      "fields": {
        "childCount": "number",
        "collectionKey": "string",
        "itemCount": "number",
        "libraryId": "number",
        "name": "string",
        "parentKey?": "string"
      }
    },
    "LibraryCollectionsParams": {
      "kind": "object",
      "fields": {
        "libraryId?": "number",
        "parentKey?": "string"
      }
    },
    "LibraryCollectionsResult": {
      "kind": "object",
      "fields": {
        "collections": "LibraryCollectionSummary[]"
      }
    },
    "LibrarySearchResult": {
      "kind": "object",
      "fields": {
        "items": "LibraryItemSummary[]",
        "nextCursor?": "string",
        "total": "number"
      }
    },
    "LibraryItemChildrenParams": {
      "kind": "object",
      "fields": {
        "itemKey": "string",
        "libraryId": "number"
      }
    },
    "LibraryAttachmentSummary": {
      "kind": "object",
      "fields": {
        "annotationCount": "number",
        "attachmentKey": "string",
        "contentType": "string",
        "filename": "string",
        "libraryId": "number",
        "parentItemKey": "string",
        "path": "string",
        "title": "string"
      }
    },
    "LibraryAttachmentParams": {
      "kind": "object",
      "fields": {
        "attachmentKey": "string",
        "libraryId": "number"
      }
    },
    "LibraryNoteSummary": {
      "kind": "object",
      "fields": {
        "libraryId": "number",
        "noteKey": "string",
        "parentItemKey": "string",
        "title": "string"
      }
    },
    "LibraryItemChildrenResult": {
      "kind": "object",
      "fields": {
        "attachments": "LibraryAttachmentSummary[]",
        "notes": "LibraryNoteSummary[]"
      }
    },
    "LibraryItemMetadataParams": {
      "kind": "object",
      "fields": {
        "itemKey": "string",
        "libraryId": "number"
      }
    },
    "LibraryItemMetadata": {
      "kind": "object",
      "fields": {
        "abstractNote": "string",
        "creators": "string[]",
        "date": "string",
        "doi?": "string",
        "itemKey": "string",
        "itemType": "string",
        "libraryId": "number",
        "publicationTitle?": "string",
        "tags": "string[]",
        "title": "string",
        "url?": "string",
        "year?": "number"
      }
    },
    "LibraryAnnotationsParams": {
      "kind": "object",
      "fields": {
        "attachmentKey": "string",
        "libraryId": "number"
      }
    },
    "LibraryAnnotationSummary": {
      "kind": "object",
      "fields": {
        "annotationKey": "string",
        "color": "string",
        "comment": "string",
        "libraryId": "number",
        "pageLabel": "string",
        "positionJson": "string",
        "sortIndex": "string",
        "text": "string",
        "type": "string"
      }
    },
    "LibraryAnnotationsResult": {
      "kind": "object",
      "fields": {
        "annotations": "LibraryAnnotationSummary[]"
      }
    },
    "LibraryNoteParams": {
      "kind": "object",
      "fields": {
        "libraryId": "number",
        "noteKey": "string"
      }
    },
    "LibraryNoteResult": {
      "kind": "object",
      "fields": {
        "html": "string",
        "libraryId": "number",
        "noteKey": "string",
        "parentItemKey": "string",
        "title": "string"
      }
    }
  }
}
