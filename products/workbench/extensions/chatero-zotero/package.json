{
  "name": "chatero-zotero",
  "displayName": "%extension.displayName%",
  "description": "%extension.description%",
  "version": "0.1.0",
  "publisher": "chatero",
  "license": "AGPL-3.0-or-later",
  "engines": {
    "vscode": "^1.132.0"
  },
  "categories": [
    "Other"
  ],
  "extensionKind": [
    "ui"
  ],
  "enabledApiProposals": [
    "chatContextProvider"
  ],
  "main": "./extension.cjs",
  "activationEvents": [
    "onView:chatero.zotero.library",
    "onView:chatero.zotero.items",
    "onCustomEditor:chatero.zotero.pdf",
    "onCustomEditor:chatero.zotero.note",
    "onChatContextProvider:zotero-pdf-evidence",
    "onChatContextProvider:chatero.chatero-zotero-zotero-pdf-evidence",
    "onCommand:chatero.zotero.research.selection",
    "onCommand:chatero.zotero.research.activeObject",
    "onCommand:chatero.zotero.research.activeNote",
    "onCommand:chatero.zotero.research.bibliography"
  ],
  "contributes": {
    "chatContext": [
      {
        "id": "zotero-pdf-evidence",
        "icon": "$(file-pdf)",
        "displayName": "Zotero PDF evidence"
      }
    ],
    "customEditors": [
      {
        "viewType": "chatero.zotero.pdf",
        "displayName": "Zotero PDF",
        "selector": [{ "filenamePattern": "*.chatero-zotero-pdf" }],
        "priority": "option"
      },
      {
        "viewType": "chatero.zotero.note",
        "displayName": "Zotero Note",
        "selector": [{ "filenamePattern": "*.chatero-zotero-note" }],
        "priority": "option"
      }
    ],
    "commands": [
      {
        "command": "chatero.zotero.startCore",
        "title": "Start Zotero Core",
        "category": "Chatero"
      },
      {
        "command": "chatero.zotero.stopCore",
        "title": "Stop Zotero Core",
        "category": "Chatero"
      },
      {
        "command": "chatero.zotero.openCompleteZotero",
        "title": "Open Complete Zotero Compatibility Mode",
        "category": "Chatero"
      },
      {
        "command": "chatero.zotero.openAttachment",
        "title": "Open Zotero Attachment",
        "category": "Chatero"
      },
      {
        "command": "chatero.zotero.openNote",
        "title": "Open Zotero Note",
        "category": "Chatero"
      },
      {
        "command": "chatero.zotero.showItemDetails",
        "title": "Show Item Details",
        "category": "Chatero"
      },
      {
        "command": "chatero.zotero.selectProfile",
        "title": "Select Zotero Profile…",
        "category": "Chatero"
      },
      {
        "command": "chatero.zotero.selectCoreExecutable",
        "title": "Select Zotero Core Executable…",
        "category": "Chatero"
      },
      {
        "command": "chatero.zotero.refreshLibrary",
        "title": "Refresh Library",
        "category": "Chatero",
        "icon": "$(refresh)"
      },
      {
        "command": "chatero.zotero.searchLibrary",
        "title": "Search Library",
        "category": "Chatero",
        "icon": "$(search)"
      },
      {
        "command": "chatero.zotero.loadMoreItems",
        "title": "Load More Zotero Items",
        "category": "Chatero",
        "icon": "$(more)"
      },
      {
        "command": "chatero.zotero.sortItems",
        "title": "Sort Zotero Items…",
        "category": "Chatero",
        "icon": "$(list-ordered)"
      },
      {
        "command": "chatero.zotero.batchTrash",
        "title": "Move Zotero Items to Trash",
        "category": "Chatero"
      },
      {
        "command": "chatero.zotero.batchRestore",
        "title": "Restore Zotero Items",
        "category": "Chatero"
      },
      {
        "command": "chatero.zotero.batchMoveToCollection",
        "title": "Move Zotero Items to Collection…",
        "category": "Chatero"
      },
      {
        "command": "chatero.zotero.retrySync",
        "title": "Retry Zotero Sync",
        "category": "Chatero",
        "icon": "$(sync)"
      },
      {
        "command": "chatero.zotero.importItems",
        "title": "Import Bibliography…",
        "category": "Chatero"
      },
      {
        "command": "chatero.zotero.exportItems",
        "title": "Export Selected Items…",
        "category": "Chatero"
      },
      {
        "command": "chatero.zotero.lookupIdentifier",
        "title": "Add Item by Identifier…",
        "category": "Chatero"
      },
      {
        "command": "chatero.zotero.editItemMetadata",
        "title": "Edit Zotero Item Metadata…",
        "category": "Chatero"
      },
      {
        "command": "chatero.zotero.saveAdvancedSearch",
        "title": "Save Advanced Zotero Search…",
        "category": "Chatero"
      },
      {
        "command": "chatero.zotero.showSyncConflicts",
        "title": "Show Zotero Sync Conflicts",
        "category": "Chatero"
      },
      {
        "command": "chatero.zotero.copyCitation",
        "title": "Copy Zotero Citation",
        "category": "Chatero"
      },
      {
        "command": "chatero.zotero.copyBibliography",
        "title": "Copy Zotero Bibliography",
        "category": "Chatero"
      },
      {
        "command": "chatero.zotero.insertCitation",
        "title": "Insert Zotero Citation",
        "category": "Chatero"
      },
      {
        "command": "chatero.zotero.copyLocateUrl",
        "title": "Copy Zotero Item URL",
        "category": "Chatero"
      },
      {
        "command": "chatero.zotero.addPdfContextToChat",
        "title": "Add PDF Page or Selection to Chat",
        "category": "Chatero"
      },
      {
        "command": "chatero.zotero.addActiveContextToChat",
        "title": "Add Active Selection to Chat",
        "category": "Chatero"
      },
      {
        "command": "chatero.zotero.sendFullPaperToRemote",
        "title": "Send Full Paper to Remote…",
        "category": "Chatero"
      }
    ],
    "configuration": {
      "title": "Chatero Zotero",
      "properties": {
        "chatero.zotero.profilePath": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Absolute path to the Zotero profile owned by Chatero Core."
        },
        "chatero.zotero.coreExecutable": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Absolute path to the bundled or development Chatero/Zotero Gecko executable."
        },
        "chatero.zotero.developerFixtureCore": {
          "type": "boolean",
          "default": false,
          "scope": "machine",
          "description": "Use the data-free fixture Core while developing the Gecko adapter."
        },
        "chatero.zotero.itemTableColumns": {
          "type": "array",
          "items": { "enum": ["creators", "year", "itemType"] },
          "uniqueItems": true,
          "default": ["creators", "year", "itemType"],
          "description": "Metadata fields shown beside titles in the native Zotero item table."
        },
        "chatero.zotero.itemTablePageSize": {
          "type": "integer",
          "minimum": 10,
          "maximum": 100,
          "default": 50,
          "description": "Number of Zotero items loaded per virtualized page."
        }
      }
    },
    "keybindings": [
      {
        "command": "chatero.zotero.addActiveContextToChat",
        "key": "ctrl+shift+l",
        "mac": "cmd+shift+l",
        "when": "activeCustomEditorId == chatero.zotero.pdf"
      },
      {
        "command": "chatero.zotero.searchLibrary",
        "key": "ctrl+f",
        "mac": "cmd+f",
        "when": "focusedView =~ /chatero.zotero.(library|items)/"
      },
      {
        "command": "chatero.zotero.batchTrash",
        "key": "delete",
        "mac": "cmd+backspace",
        "when": "focusedView == chatero.zotero.items && chateroZoteroHasSelection"
      }
    ],
    "menus": {
      "view/item/context": [
        {
          "command": "chatero.zotero.showItemDetails",
          "when": "viewItem == chateroZoteroItem",
          "group": "inline"
        },
        {
          "command": "chatero.zotero.editItemMetadata",
          "when": "viewItem == chateroZoteroItem",
          "group": "zotero@1"
        },
        {
          "command": "chatero.zotero.copyCitation",
          "when": "viewItem == chateroZoteroItem",
          "group": "zotero@2"
        },
        {
          "command": "chatero.zotero.copyBibliography",
          "when": "viewItem == chateroZoteroItem",
          "group": "zotero@3"
        },
        {
          "command": "chatero.zotero.insertCitation",
          "when": "viewItem == chateroZoteroItem",
          "group": "zotero@4"
        }
      ],
      "view/title": [
        {
          "command": "chatero.zotero.searchLibrary",
          "when": "view == chatero.zotero.library",
          "group": "navigation@1"
        },
        {
          "command": "chatero.zotero.refreshLibrary",
          "when": "view == chatero.zotero.library",
          "group": "navigation@2"
        },
        {
          "command": "chatero.zotero.sortItems",
          "when": "view == chatero.zotero.items",
          "group": "navigation@1"
        },
        {
          "command": "chatero.zotero.loadMoreItems",
          "when": "view == chatero.zotero.items && chateroZoteroHasMoreItems",
          "group": "navigation@2"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "chatero-zotero",
          "title": "Chatero Library",
          "icon": "media/library.svg"
        }
      ]
    },
    "views": {
      "chatero-zotero": [
        {
          "id": "chatero.zotero.library",
          "name": "Library Sources"
        },
        {
          "id": "chatero.zotero.items",
          "name": "Items",
          "accessibilityHelpContent": "chatero.zotero.items.accessibilityHelp"
        }
      ]
    },
    "accessibilityHelpContent": [
      {
        "name": "Zotero item table help",
        "id": "chatero.zotero.items.accessibilityHelp",
        "content": "%accessibility.items%"
      }
    ]
  }
}
