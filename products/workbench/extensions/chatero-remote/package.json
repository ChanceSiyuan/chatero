{
  "name": "chatero-remote",
  "displayName": "Chatero Remote",
  "description": "Open SSH Linux workspaces through a signed Chatero Remote Agent.",
  "version": "0.1.0",
  "publisher": "chatero",
  "license": "MIT",
  "private": true,
  "engines": {
    "vscode": "^1.132.0"
  },
  "categories": [
    "Other"
  ],
  "extensionKind": [
    "ui"
  ],
  "enabledApiProposals": [
    "resolvers"
  ],
  "main": "./extension.cjs",
  "activationEvents": [
    "onResolveRemoteAuthority:chatero-remote"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": true
  },
  "contributes": {
    "commands": [
      {
        "command": "chatero.remote.connect",
        "title": "Connect to SSH…",
        "category": "Chatero"
      },
      {
        "command": "chatero.remote.openFolder",
        "title": "Open Remote Folder…",
        "category": "Chatero"
      },
      {
        "command": "chatero.remote.reconnect",
        "title": "Reconnect",
        "category": "Chatero"
      },
      {
        "command": "chatero.remote.showLog",
        "title": "Show Remote Log",
        "category": "Chatero"
      },
      {
        "command": "chatero.remote.openLoginTerminal",
        "title": "Open SSH Login Terminal",
        "category": "Chatero"
      }
    ],
    "menus": {
      "statusBar/remoteIndicator": [
        {
          "command": "chatero.remote.connect",
          "when": "remoteName != chatero-remote",
          "group": "remote_50_chatero-remote_connect"
        },
        {
          "command": "chatero.remote.openFolder",
          "when": "remoteName == chatero-remote",
          "group": "remote_50_chatero-remote_open-folder"
        },
        {
          "command": "chatero.remote.reconnect",
          "when": "remoteName == chatero-remote",
          "group": "remote_51_chatero-remote_reconnect"
        },
        {
          "command": "chatero.remote.showLog",
          "when": "remoteName == chatero-remote",
          "group": "remote_52_chatero-remote_log"
        }
      ]
    },
    "resourceLabelFormatters": [
      {
        "scheme": "vscode-remote",
        "authority": "chatero-remote+*",
        "formatting": {
          "label": "${path}",
          "separator": "/",
          "tildify": true,
          "workspaceSuffix": "Chatero SSH",
          "workspaceTooltip": "Linux workspace connected through system OpenSSH"
        }
      }
    ]
  }
}
