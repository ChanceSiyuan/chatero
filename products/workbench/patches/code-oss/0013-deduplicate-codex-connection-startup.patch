@@ -229,6 +230,37 @@ suite('CodexAgent prewarm eviction', () => {
 
 	const disposables = ensureNoDisposablesAreLeakedInTestSuite();
 
+	test('reuses a connection established while OpenAI validation was pending', async () => {
+		const agent = Object.create(CodexAgent.prototype) as CodexAgent;
+		const validation = new DeferredPromise<void>();
+		const established = {
+			kind: 'ready',
+			client: {},
+			usageSource: 'openai',
+			child: { kill: () => true },
+		} as never;
+		agent['_connection'] = { kind: 'idle' };
+		agent['_connectionGeneration'] = 0;
+		agent['_usageSource'] = 'openai';
+		agent['_usageSourceValidation'] = validation.p;
+		let starts = 0;
+		agent['_startConnection'] = (async () => {
+			starts++;
+			return {
+				client: {},
+				usageSource: 'openai',
+				child: { kill: () => true },
+			} as never;
+		}) as never;
+
+		const pending = agent['_ensureConnection']();
+		agent['_connection'] = established;
+		validation.complete();
+
+		assert.strictEqual(await pending, established);
+		assert.strictEqual(starts, 0);
+	});
+
 	test('evicts a completed folder prewarm when the first send resolves to a worktree', async () => {
 		await assertPrewarmEvictedOnSend(disposables, true);
 	});
