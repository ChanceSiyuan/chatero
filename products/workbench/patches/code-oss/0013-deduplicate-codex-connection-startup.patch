 				validation = this._usageSourceValidation;
 				await validation;
 			}
+			// Validation can establish the shared connection while this caller is
+			// suspended. Re-check the state before spawning so an earlier waiter and
+			// the validation path cannot create two app-server processes.
+			const connectionAfterValidation = this._connection as ConnectionState;
+			if (connectionAfterValidation.kind === 'ready') {
+				return connectionAfterValidation;
+			}
+			if (connectionAfterValidation.kind === 'starting') {
+				return connectionAfterValidation.promise;
+			}
 		}
