+const CHATERO_TEXT_CONTEXT_ID_PREFIX = 'chatero-text:';
+const CHATERO_TEXT_CONTEXT_ID_PATTERN = /^chatero-text:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;
+const CHATERO_TEXT_CONTEXT_LABEL_MAX_BYTES = 256;
+const CHATERO_TEXT_CONTEXT_MAX_BYTES = 256 * 1024;
+
+interface IChateroTextContext {
+	readonly label: string;
+	readonly text: string;
+}
+
+function parseChateroTextContext(value: unknown): IChateroTextContext {
+	if (!isObject(value) || Array.isArray(value)) {
+		throw new TypeError('Text context must be an object');
+	}
+	const keys = Object.keys(value).sort();
+	if (keys.length !== 2 || keys[0] !== 'label' || keys[1] !== 'text') {
+		throw new TypeError('Text context accepts only label and text');
+	}
+	const { label, text } = value as { label?: unknown; text?: unknown };
+	if (typeof label !== 'string' || label.trim().length === 0 || VSBuffer.fromString(label).byteLength > CHATERO_TEXT_CONTEXT_LABEL_MAX_BYTES) {
+		throw new TypeError(`Text context label must be 1-${CHATERO_TEXT_CONTEXT_LABEL_MAX_BYTES} UTF-8 bytes`);
+	}
+	if (typeof text !== 'string' || text.length === 0 || VSBuffer.fromString(text).byteLength > CHATERO_TEXT_CONTEXT_MAX_BYTES) {
+		throw new TypeError(`Text context must be 1-${CHATERO_TEXT_CONTEXT_MAX_BYTES} UTF-8 bytes`);
+	}
+	return { label, text };
+}
+
+class AttachChateroTextContextAction extends Action2 {
+	static readonly ID = 'chatero.chat.attachTextContext';
+
+	constructor() {
+		super({
+			id: AttachChateroTextContextAction.ID,
+			title: localize2('chatero.chat.attachTextContext', "Attach Text Context"),
+			category: CHAT_CATEGORY,
+			f1: false,
+		});
+	}
+
+	override async run(accessor: ServicesAccessor, value: unknown): Promise<string> {
+		const context = parseChateroTextContext(value);
+		const widget = await accessor.get(IInstantiationService).invokeFunction(withChatView);
+		if (!widget) {
+			throw new Error('Chat input is unavailable');
+		}
+		const token = generateUuid();
+		const id = CHATERO_TEXT_CONTEXT_ID_PREFIX + token;
+		widget.attachmentModel.addContext({
+			kind: 'string',
+			id,
+			name: context.label,
+			value: context.text,
+			uri: URI.from({ scheme: 'chatero-text-context', path: `/${token}` }),
+			handle: -1,
+		});
+		widget.focusInput();
+		return id;
+	}
+}
+
+class RemoveChateroTextContextAction extends Action2 {
+	static readonly ID = 'chatero.chat.removeTextContext';
+
+	constructor() {
+		super({
+			id: RemoveChateroTextContextAction.ID,
+			title: localize2('chatero.chat.removeTextContext', "Remove Text Context"),
+			category: CHAT_CATEGORY,
+			f1: false,
+		});
+	}
+
+	override async run(accessor: ServicesAccessor, id: unknown): Promise<boolean> {
+		if (typeof id !== 'string' || !CHATERO_TEXT_CONTEXT_ID_PATTERN.test(id)) {
+			throw new TypeError('Text context id is invalid');
+		}
+		const widget = await accessor.get(IInstantiationService).invokeFunction(withChatView);
+		if (!widget || !widget.attachmentModel.getAttachmentIDs().has(id)) {
+			return false;
+		}
+		widget.attachmentModel.delete(id);
+		return true;
+	}
+}
