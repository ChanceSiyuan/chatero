+		// contribution exists. Once the product default is available, replace only
+		// that request-free fallback. showModel preserves text typed during the
+		// transition and ignoreTransferredSession prevents reacquiring the stale
+		// local resource that caused the first Send click to be rejected.
+		this.restoringSession = this.showModel(CancellationToken.None, undefined, true, true)
+			.then(() => undefined)
+			.catch(error => this.logService.error('ChatViewPane#_migrateEmptyLocalSessionToDefault failed', error));
+		this.restoringSession.finally(() => this.restoringSession = undefined);
+		return true;
+	}
