+ *  Licensed under the MIT License. See License.txt in the project root for license information.
+ *--------------------------------------------------------------------------------------------*/
+
+import assert from 'assert';
+import * as fs from 'fs';
+import * as os from 'os';
+import * as path from 'path';
+import { DisposableStore } from '../../../../base/common/lifecycle.js';
+import { Schemas } from '../../../../base/common/network.js';
+import { URI } from '../../../../base/common/uri.js';
+import { ensureNoDisposablesAreLeakedInTestSuite } from '../../../../base/test/common/utils.js';
+import { FileService } from '../../../files/common/fileService.js';
+import { NullLogService } from '../../../log/common/log.js';
+import { registerAgentHostFileProviders } from '../../node/agentHostBootstrap.js';
+
+suite('AgentHostBootstrap', () => {
+	const disposables = new DisposableStore();
+	const roots: string[] = [];
+
+	teardown(() => {
+		disposables.clear();
+		for (const root of roots.splice(0)) {
+			fs.rmSync(root, { recursive: true, force: true });
+		}
+	});
+	ensureNoDisposablesAreLeakedInTestSuite();
+
+	test('maps vscode-userdata resources to their on-disk paths', async () => {
+		const root = fs.mkdtempSync(path.join(os.tmpdir(), 'chatero-agent-host-bootstrap-'));
+		roots.push(root);
+		const settingsPath = path.join(root, 'User', 'settings.json');
+		fs.mkdirSync(path.dirname(settingsPath), { recursive: true });
+		fs.writeFileSync(settingsPath, '{"http.proxy":"http://127.0.0.1:9876"}');
+
+		const logService = new NullLogService();
+		const fileService = disposables.add(new FileService(logService));
+		registerAgentHostFileProviders(fileService, logService, disposables);
+
+		const settingsResource = URI.file(settingsPath).with({ scheme: Schemas.vscodeUserData });
+		assert.strictEqual((await fileService.readFile(settingsResource)).value.toString(), '{"http.proxy":"http://127.0.0.1:9876"}');
+		assert.doesNotThrow(() => disposables.add(fileService.watch(URI.file(path.dirname(settingsPath)).with({ scheme: Schemas.vscodeUserData }))));
+	});
+});
