+export function registerAgentHostFileProviders(
+	fileService: IFileService,
+	logService: ILogService,
+	disposables: DisposableStore,
+): void {
+	// NativeEnvironmentService represents User resources with the
+	// vscode-userdata scheme even in standalone Agent Host processes. Those
+	// processes do not create the profile services required by
+	// FileUserDataProvider, but the URI path is already the exact on-disk user
+	// data path. Give each scheme its own disk provider so settings reads and
+	// watches work without double-forwarding one provider's change events.
+	const diskFileSystemProvider = disposables.add(new DiskFileSystemProvider(logService));
+	disposables.add(fileService.registerProvider(Schemas.file, diskFileSystemProvider));
+	const userDataFileSystemProvider = disposables.add(new DiskFileSystemProvider(logService));
+	disposables.add(fileService.registerProvider(Schemas.vscodeUserData, userDataFileSystemProvider));
+}
