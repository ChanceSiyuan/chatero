+/*---------------------------------------------------------------------------------------------
+ *  Copyright (c) Chatero contributors. All rights reserved.
+ *  Licensed under the MIT License. See License.txt in the project root for license information.
+ *--------------------------------------------------------------------------------------------*/
+
+declare module 'vscode' {
+	export interface DocumentationWorkingCopyBarrierResource {
+		readonly uri: Uri;
+		readonly expectedVersion?: number;
+		readonly expectedDigest?: string;
+		readonly intendedDigest?: string;
+		readonly expectedDirectoryGeneration?: string;
+		readonly requireClean: boolean;
+		readonly targetAbsent?: boolean;
+	}
+
+	export interface DocumentationWorkingCopyDirty {
+		readonly kind: 'dirty-working-copy';
+		readonly uri: Uri;
+	}
+
+	export interface DocumentationWorkingCopyBarrierConflict {
+		readonly kind: 'barrier-conflict';
+		readonly uri?: Uri;
+		readonly reason: string;
+	}
+
+	export type DocumentationWorkingCopyBarrierValidation =
+		| { readonly kind: 'valid' }
+		| DocumentationWorkingCopyDirty
+		| DocumentationWorkingCopyBarrierConflict;
