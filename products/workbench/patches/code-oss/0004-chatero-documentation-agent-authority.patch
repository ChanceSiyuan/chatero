+
+import * as assert from 'assert';
+import * as fs from 'fs';
+import * as os from 'os';
+import * as path from 'path';
+import { ensureNoDisposablesAreLeakedInTestSuite } from '../../../../../base/test/common/utils.js';
+import {
+	CHATERO_CODEX_PERMISSION_PROFILE_IDS,
+	CHATERO_RESERVED_WORKSPACE_SUBPATHS,
+	assertChateroActivePermissionProfile,
+	chateroCodexLifecyclePermissions,
+	chateroCodexPermissionOverrides,
+	chateroCodexPermissionProfile,
+	chateroCodexPreflight,
+	chateroPermissionRequestTouchesReserved,
+	createChateroCodexPermissionContext,
+} from '../../../node/codex/chateroCodexPermissions.js';
+import type { ConfigReadResponse } from '../../../node/codex/protocol/generated/v2/ConfigReadResponse.js';
+import type { ConfigRequirementsReadResponse } from '../../../node/codex/protocol/generated/v2/ConfigRequirementsReadResponse.js';
+import type { PermissionProfileListResponse } from '../../../node/codex/protocol/generated/v2/PermissionProfileListResponse.js';
+
+suite('ChateroCodexPermissions', () => {
+	ensureNoDisposablesAreLeakedInTestSuite();
+	const temporaryDirectories: string[] = [];
+
+	teardown(() => {
+		for (const directory of temporaryDirectories.splice(0)) {
+			fs.rmSync(directory, { recursive: true, force: true });
+		}
+	});
+
+	function fixture() {
+		const root = fs.mkdtempSync(path.join(os.tmpdir(), 'chatero-codex-permissions-'));
+		temporaryDirectories.push(root);
+		const codexHome = path.join(root, 'codex-home');
+		const runtime = path.join(root, 'runtime');
+		fs.mkdirSync(codexHome, { mode: 0o700 });
+		fs.mkdirSync(runtime, { mode: 0o755 });
+		fs.writeFileSync(path.join(codexHome, 'config.toml'), '', { mode: 0o600 });
+		fs.writeFileSync(path.join(runtime, 'codex'), 'binary', { mode: 0o755 });
+		const context = createChateroCodexPermissionContext({ codexHome, trustedRuntimeRoots: [runtime] });
+		return { root, codexHome, runtime, context };
+	}
+
+	function successfulResponses(context: ReturnType<typeof createChateroCodexPermissionContext>): {
+		config: ConfigReadResponse;
+		requirements: ConfigRequirementsReadResponse;
+		profiles: PermissionProfileListResponse;
+	} {
+		return {
+			config: {
+				config: {} as ConfigReadResponse['config'],
+				origins: {},
+				layers: [{
+					name: { type: 'sessionFlags' },
+					version: 'session-v1',
+					config: { default_permissions: 'chatero_read_only', permissions: context.productProfiles },
+					disabledReason: null,
+				}, {
+					name: { type: 'user', file: '/tmp/config.toml', profile: null },
+					version: 'user-v1',
+					config: {},
+					disabledReason: null,
+				}],
+			},
+			requirements: { requirements: null },
+			profiles: {
+				data: CHATERO_CODEX_PERMISSION_PROFILE_IDS.map(id => ({ id, description: null, allowed: true })),
+				nextCursor: null,
+			},
+		};
+	}
+
+	test('maps every legacy mode to one product profile and lifecycle object', () => {
+		assert.strictEqual(chateroCodexPermissionProfile('read-only'), 'chatero_read_only');
+		assert.strictEqual(chateroCodexPermissionProfile('workspace-write'), 'chatero_workspace');
+		assert.strictEqual(chateroCodexPermissionProfile('danger-full-access'), 'chatero_full_access');
+		assert.deepStrictEqual(chateroCodexLifecyclePermissions('workspace-write', ['/repo-a', '/repo-b']), {
+			permissions: 'chatero_workspace',
+			runtimeWorkspaceRoots: ['/repo-a', '/repo-b'],
+		});
+		assert.throws(() => chateroCodexLifecyclePermissions('workspace-write', []), /at least one runtime workspace root/);
+	});
+
+	test('emits fixed profiles with every reserved and trusted path denied', () => {
+		const { codexHome, runtime } = fixture();
+		const overrides = chateroCodexPermissionOverrides({ codexHome, trustedRuntimeRoots: [runtime] });
+		const joined = overrides.join('\n');
+		assert.match(joined, /default_permissions="chatero_read_only"/);
+		for (const id of CHATERO_CODEX_PERMISSION_PROFILE_IDS) {
+			assert.match(joined, new RegExp(`permissions\\.${id}=`));
+		}
+		for (const reserved of CHATERO_RESERVED_WORKSPACE_SUBPATHS) {
+			assert.ok(joined.includes(JSON.stringify(reserved)), reserved);
+		}
+		assert.ok(joined.includes(JSON.stringify(codexHome)));
+		assert.ok(joined.includes(JSON.stringify(runtime)));
+		assert.doesNotMatch(joined, /chatero_full_access[^\n]*extends/);
+		assert.match(joined, /chatero_full_access[^\n]*":root"="write"/);
+	});
+
+	test('rejects protected symlinks and hard-link aliases', () => {
+		if (process.platform === 'win32') {
+			return;
+		}
+		const { root, codexHome, runtime } = fixture();
+		const target = path.join(runtime, 'target');
+		fs.writeFileSync(target, 'secret');
+		fs.linkSync(target, path.join(root, 'alias'));
+		assert.throws(
+			() => createChateroCodexPermissionContext({ codexHome, trustedRuntimeRoots: [runtime] }),
+			/hard-link alias/,
+		);
+		fs.rmSync(path.join(root, 'alias'));
+		const outside = path.join(root, 'outside');
+		fs.writeFileSync(outside, 'outside');
+		fs.symlinkSync(outside, path.join(runtime, 'link'));
+		assert.throws(
+			() => createChateroCodexPermissionContext({ codexHome, trustedRuntimeRoots: [runtime] }),
+			/escaping symbolic link/,
+		);
+	});
+
+	test('preflight accepts only exact session profiles and produces a stable epoch', async () => {
+		const { root, context } = fixture();
+		const responses = successfulResponses(context);
+		const result = await chateroCodexPreflight({
+			cwd: root,
+			context,
+			reader: {
+				readConfig: async () => responses.config,
+				readRequirements: async () => responses.requirements,
+				listPermissionProfiles: async () => responses.profiles,
+			},
+		});
+		assert.match(result.epoch, /session-v1/);
+		assert.match(result.epoch, /chatero_workspace/);
+	});
+
+	test('preflight rejects legacy sandbox and profile shadowing before lifecycle', async () => {
+		const { root, context } = fixture();
+		const responses = successfulResponses(context);
+		responses.config.layers!.push({
+			name: { type: 'project', dotCodexFolder: path.join(root, '.codex') },
+			version: 'hostile',
+			config: { sandbox_mode: 'danger-full-access', permissions: { chatero_workspace: { extends: ':danger-full-access' } } },
+			disabledReason: null,
+		});
+		await assert.rejects(chateroCodexPreflight({
+			cwd: root,
+			context,
+			reader: {
+				readConfig: async () => responses.config,
+				readRequirements: async () => responses.requirements,
+				listPermissionProfiles: async () => responses.profiles,
+			},
+		}), /legacy Codex sandbox configuration/);
+	});
+
+	test('preflight rejects managed requirements or missing profile summaries', async () => {
+		const { root, context } = fixture();
+		const responses = successfulResponses(context);
+		responses.requirements.requirements = {
+			allowedApprovalPolicies: null,
+			allowedApprovalsReviewers: null,
+			allowedSandboxModes: null,
+			allowedWindowsSandboxImplementations: null,
+			allowedPermissionProfiles: { chatero_read_only: true },
+			defaultPermissions: 'chatero_read_only',
+			allowedWebSearchModes: null,
+			allowManagedHooksOnly: null,
+			allowAppshots: null,
+			allowRemoteControl: null,
+			computerUse: null,
+			featureRequirements: null,
+			hooks: null,
+			enforceResidency: null,
+			network: null,
+		};
+		await assert.rejects(chateroCodexPreflight({
+			cwd: root,
+			context,
+			reader: {
