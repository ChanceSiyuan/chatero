new file mode 100644
index 0000000000000000000000000000000000000000..b1921c624901eb2b1a2b498abddf186452c625b0
--- /dev/null
+++ b/src/vs/workbench/api/common/chateroDocumentationBarrier.ts
@@ -0,0 +1,306 @@
+/*---------------------------------------------------------------------------------------------
+ *  Copyright (c) Chatero contributors. All rights reserved.
+ *  Licensed under the MIT License. See License.txt in the project root for license information.
+ *--------------------------------------------------------------------------------------------*/
+
+import type * as vscode from 'vscode';
+import { DisposableStore } from '../../../base/common/lifecycle.js';
+import { URI } from '../../../base/common/uri.js';
+import * as files from '../../../platform/files/common/files.js';
+import type { IExtensionDescription } from '../../../platform/extensions/common/extensions.js';
+import { ExtHostBulkEdits } from './extHostBulkEdits.js';
+import { ExtHostDocuments } from './extHostDocuments.js';
+import type { IExtHostConsumerFileSystem } from './extHostFileSystemConsumer.js';
+import { FileEditType, WorkspaceEdit } from './extHostTypes/workspaceEdit.js';
+
+const CHATERO_DOCUMENTATION_EXTENSION = 'chatero.chatero-documentation';
+const DIGEST_PATTERN = /^sha256:[0-9a-f]{64}$/;
+const activeResources = new Map<string, DocumentationBarrier>();
+
+interface IBarrierServices {
+	readonly documents: ExtHostDocuments;
+	readonly bulkEdits: ExtHostBulkEdits;
+	readonly fileSystem: IExtHostConsumerFileSystem;
+}
+
+export async function acquireDocumentationWorkingCopyBarrier(
+	extension: IExtensionDescription,
+	services: IBarrierServices,
+	input: Readonly<{
+		operationId: string;
+		resources: readonly vscode.DocumentationWorkingCopyBarrierResource[];
+		reason: 'human-transaction' | 'settlement' | 'migration' | 'recovery';
+	}>,
+): Promise<vscode.DocumentationWorkingCopyBarrierLease | vscode.DocumentationWorkingCopyDirty | vscode.DocumentationWorkingCopyBarrierConflict> {
+	if (extension.identifier.value.toLowerCase() !== CHATERO_DOCUMENTATION_EXTENSION) {
+		throw new Error('Documentation Working Copy Barrier is product-private');
+	}
+	if (!/^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$/.test(input.operationId) || input.resources.length === 0) {
+		throw new Error('invalid Documentation Working Copy Barrier request');
+	}
+	const resources = normalizeResources(input.resources);
+	for (const resource of resources) {
+		if (activeResources.has(resource.key)) {
+			return conflict('resource is already protected by another Documentation operation', resource.uri);
+		}
+	}
+	const barrier = new DocumentationBarrier(extension, services, input.operationId, resources);
+	for (const resource of resources) {
+		activeResources.set(resource.key, barrier);
+	}
+	barrier.installObservers();
+	const validation = await barrier.revalidate();
+	if (validation.kind !== 'valid') {
+		barrier.release();
+		return validation;
+	}
+	return barrier;
+}
+
+interface INormalizedResource extends vscode.DocumentationWorkingCopyBarrierResource {
+	readonly uri: URI;
+	readonly key: string;
+}
+
+class DocumentationBarrier implements vscode.DocumentationWorkingCopyBarrierLease {
+	private readonly disposables = new DisposableStore();
+	private conflictReason: string | undefined;
+	private ownerApplying = false;
+	private applied = false;
+	private finalized = false;
+	private disposed = false;
+
+	constructor(
+		private readonly extension: IExtensionDescription,
+		private readonly services: IBarrierServices,
+		readonly operationId: string,
+		private readonly resources: readonly INormalizedResource[],
+	) { }
+
+	installObservers(): void {
+		const observe = (document: vscode.TextDocument) => {
+			if (!this.ownerApplying && !this.applied && this.resources.some(resource => resource.key === document.uri.toString())) {
+				this.conflictReason = 'working copy changed while the Documentation barrier was active';
+			}
+		};
+		this.disposables.add(this.services.documents.onDidAddDocument(observe));
+		this.disposables.add(this.services.documents.onDidChangeDocument(event => observe(event.document)));
+		this.disposables.add(this.services.documents.onDidSaveDocument(observe));
+	}
+
+	async revalidate(): Promise<vscode.DocumentationWorkingCopyBarrierValidation> {
+		if (this.disposed) {
+			return conflict('Documentation barrier lease is disposed');
+		}
+		if (this.conflictReason) {
+			return conflict(this.conflictReason);
+		}
+		for (const resource of this.resources) {
+			const document = this.services.documents.getDocumentData(resource.uri)?.document;
+			if (document) {
+				if (resource.targetAbsent) {
+					return conflict('target resource is already open', resource.uri);
+				}
+				if (resource.requireClean && document.isDirty) {
+					return { kind: 'dirty-working-copy', uri: resource.uri };
+				}
+				if (resource.expectedVersion !== undefined && document.version !== resource.expectedVersion) {
+					return conflict('TextDocument version changed', resource.uri);
+				}
+				if (resource.expectedDigest && await sha256Text(document.getText()) !== resource.expectedDigest) {
+					return conflict('TextDocument digest changed', resource.uri);
+				}
+				continue;
+			}
+			if (resource.expectedVersion !== undefined) {
+				return conflict('expected TextDocument is not open', resource.uri);
+			}
+			const stat = await tryStat(this.services.fileSystem.value, resource.uri);
+			if (resource.targetAbsent) {
+				if (stat) {
+					return conflict('target resource exists', resource.uri);
+				}
+				continue;
+			}
+			if (!stat) {
+				return conflict('bound resource is missing', resource.uri);
+			}
+			if (resource.expectedDirectoryGeneration !== undefined) {
+				return conflict('directory generation requires the authority-side verifier', resource.uri);
+			}
+			if (resource.expectedDigest) {
+				const bytes = await this.services.fileSystem.value.readFile(resource.uri);
+				if (await sha256Bytes(bytes) !== resource.expectedDigest) {
+					return conflict('resource digest changed', resource.uri);
+				}
+			}
+		}
+		return { kind: 'valid' };
+	}
+
+	async applyWorkspaceEdit(edit: vscode.WorkspaceEdit): Promise<boolean> {
+		if (this.applied || this.disposed || !(edit instanceof WorkspaceEdit)) {
+			return false;
+		}
+		const validation = await this.revalidate();
+		if (validation.kind !== 'valid' || !await this.validateEdit(edit)) {
+			return false;
+		}
+		this.ownerApplying = true;
+		try {
+			this.applied = await this.services.bulkEdits.applyWorkspaceEdit(edit, this.extension, { isRefactoring: false });
+			return this.applied;
+		} finally {
+			this.ownerApplying = false;
+		}
+	}
+
+	async finalizeResourceOutcomes(outcomes: readonly vscode.DocumentationResourceOutcome[]): Promise<boolean> {
+		if (!this.applied || this.finalized || this.disposed) {
+			return false;
+		}
+		const normalized = outcomes.map(outcome => ({
+			kind: outcome.kind,
+			uri: URI.revive(outcome.uri).toString(),
+			targetUri: outcome.targetUri ? URI.revive(outcome.targetUri).toString() : undefined,
+			digest: outcome.digest,
+		})).sort((left, right) => compareBytes(`${left.kind}:${left.uri}`, `${right.kind}:${right.uri}`));
+		const structural = this.resources.filter(resource => resource.targetAbsent || (resource.requireClean && resource.expectedVersion === undefined));
+		if (normalized.length !== structural.length || normalized.some(outcome => {
+			if (outcome.digest && !DIGEST_PATTERN.test(outcome.digest)) {
+				return true;
+			}
+			return !this.resources.some(resource => resource.key === outcome.uri || resource.key === outcome.targetUri);
+		})) {
+			return false;
+		}
+		this.finalized = true;
+		return true;
+	}
+
+	dispose(): void {
+		if (this.applied && this.resources.some(resource => resource.targetAbsent || resource.expectedDirectoryGeneration) && !this.finalized) {
+			this.conflictReason = 'structural Documentation outcomes were not finalized';
+			return;
+		}
+		this.release();
+	}
+
+	release(): void {
+		if (this.disposed) {
+			return;
+		}
+		this.disposed = true;
+		this.disposables.dispose();
+		for (const resource of this.resources) {
+			if (activeResources.get(resource.key) === this) {
+				activeResources.delete(resource.key);
+			}
+		}
+	}
+
+	private async validateEdit(edit: WorkspaceEdit): Promise<boolean> {
+		const touched = new Set<string>();
+		for (const entry of edit._allEntries()) {
+			if (entry._type === FileEditType.Cell || entry._type === FileEditType.CellReplace || entry._type === FileEditType.Snippet) {
+				return false;
+			}
+			if (entry._type === FileEditType.File) {
+				for (const uri of [entry.from, entry.to]) {
+					if (uri) {
+						touched.add(uri.toString());
+					}
+				}
+			} else {
+				touched.add(entry.uri.toString());
+			}
+		}
+		if ([...touched].some(key => !this.resources.some(resource => resource.key === key))) {
+			return false;
+		}
+		for (const resource of this.resources) {
+			if (!resource.intendedDigest || !touched.has(resource.key)) {
+				continue;
+			}
+			const document = this.services.documents.getDocumentData(resource.uri)?.document;
+			if (!document) {
+				continue;
+			}
+			const edits = edit.get(resource.uri);
+			const replacements = edits.map(value => ({
+				start: document.offsetAt(value.range.start),
+				end: document.offsetAt(value.range.end),
+				text: value.newText,
+			})).sort((left, right) => right.start - left.start || right.end - left.end);
+			let text = document.getText();
+			let nextStart = text.length;
+			for (const replacement of replacements) {
+				if (replacement.start < 0 || replacement.end < replacement.start || replacement.end > nextStart) {
+					return false;
+				}
+				text = `${text.slice(0, replacement.start)}${replacement.text}${text.slice(replacement.end)}`;
+				nextStart = replacement.start;
+			}
+			if (await sha256Text(text) !== resource.intendedDigest) {
+				return false;
+			}
+		}
+		return true;
+	}
+}
+
+function normalizeResources(resources: readonly vscode.DocumentationWorkingCopyBarrierResource[]): INormalizedResource[] {
+	const result = resources.map(resource => {
+		const uri = URI.revive(resource.uri);
+		if (uri.scheme !== 'file' && uri.scheme !== 'vscode-remote') {
+			throw new Error(`unsupported Documentation barrier URI scheme: ${uri.scheme}`);
+		}
+		if ((resource.expectedDigest && !DIGEST_PATTERN.test(resource.expectedDigest))
+			|| (resource.intendedDigest && !DIGEST_PATTERN.test(resource.intendedDigest))
+			|| (resource.expectedDirectoryGeneration && !DIGEST_PATTERN.test(resource.expectedDirectoryGeneration))) {
+			throw new Error('invalid Documentation barrier digest');
+		}
+		return Object.freeze({ ...resource, uri, key: uri.toString() });
+	}).sort((left, right) => compareBytes(left.key, right.key));
+	for (let index = 1; index < result.length; index++) {
+		if (result[index - 1].key === result[index].key) {
+			throw new Error('duplicate Documentation barrier resource');
+		}
+	}
+	return result;
+}
+
+async function tryStat(fileSystem: vscode.FileSystem, uri: URI): Promise<vscode.FileStat | undefined> {
+	try {
+		return await fileSystem.stat(uri);
+	} catch (error) {
+		if (files.toFileSystemProviderErrorCode(error) === files.FileSystemProviderErrorCode.FileNotFound) {
+			return undefined;
+		}
+		throw error;
+	}
+}
+
+async function sha256Text(value: string): Promise<string> {
+	return sha256Bytes(new TextEncoder().encode(value));
+}
+
+async function sha256Bytes(value: Uint8Array): Promise<string> {
+	const digest = new Uint8Array(await globalThis.crypto.subtle.digest('SHA-256', value));
+	return `sha256:${[...digest].map(byte => byte.toString(16).padStart(2, '0')).join('')}`;
+}
+
+function conflict(reason: string, uri?: URI): vscode.DocumentationWorkingCopyBarrierConflict {
+	return { kind: 'barrier-conflict', reason, ...(uri ? { uri } : {}) };
+}
+
+function compareBytes(left: string, right: string): number {
+	const leftBytes = new TextEncoder().encode(left);
+	const rightBytes = new TextEncoder().encode(right);
+	for (let index = 0; index < Math.min(leftBytes.length, rightBytes.length); index++) {
+		if (leftBytes[index] !== rightBytes[index]) {
+			return leftBytes[index] - rightBytes[index];
+		}
+	}
+	return leftBytes.length - rightBytes.length;
+}
