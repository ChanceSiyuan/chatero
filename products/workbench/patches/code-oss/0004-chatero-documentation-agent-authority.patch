+import * as fs from 'fs';
+import { isAbsolute, join, normalize, relative, resolve, sep } from '../../../../base/common/path.js';
+import type { SandboxMode } from './protocol/generated/v2/SandboxMode.js';
+import type { ActivePermissionProfile } from './protocol/generated/v2/ActivePermissionProfile.js';
+import type { AdditionalFileSystemPermissions } from './protocol/generated/v2/AdditionalFileSystemPermissions.js';
+import type { ConfigReadResponse } from './protocol/generated/v2/ConfigReadResponse.js';
+import type { ConfigRequirementsReadResponse } from './protocol/generated/v2/ConfigRequirementsReadResponse.js';
+import type { PermissionProfileListResponse } from './protocol/generated/v2/PermissionProfileListResponse.js';
+
+export const CHATERO_RESERVED_WORKSPACE_SUBPATHS = Object.freeze([
+	'documentation',
+	'.chatero',
+	'work/qlab-zotero/documentation-changes',
+	'work/qlab-zotero/documentation-migration',
+	'.codex',
+]);
+
+export const CHATERO_CODEX_PERMISSION_PROFILE_IDS = Object.freeze([
+	'chatero_read_only',
+	'chatero_workspace',
+	'chatero_full_access',
+] as const);
+
+export type ChateroCodexPermissionProfileId = typeof CHATERO_CODEX_PERMISSION_PROFILE_IDS[number];
+
+type JsonObject = Record<string, unknown>;
+
+export interface IChateroProtectedObjectIdentity {
+	readonly path: string;
+	readonly realPath: string;
+	readonly dev: number;
+	readonly ino: number;
+	readonly mode: number;
+	readonly nlink: number;
+	readonly kind: 'directory' | 'file' | 'symlink';
+}
+
+export interface IChateroCodexPermissionContext {
+	readonly codexHome: string;
+	readonly trustedRuntimeRoots: readonly string[];
+	readonly productProfiles: Readonly<Record<ChateroCodexPermissionProfileId, JsonObject>>;
+	readonly launchOverrides: readonly string[];
+	readonly protectedObjects: readonly IChateroProtectedObjectIdentity[];
+}
+
+export interface IChateroCodexPreflightReader {
+	readConfig(cwd: string): Promise<ConfigReadResponse>;
+	readRequirements(): Promise<ConfigRequirementsReadResponse>;
+	listPermissionProfiles(cwd: string): Promise<PermissionProfileListResponse>;
+}
+
+const EXPECTED_PARENT: Readonly<Record<ChateroCodexPermissionProfileId, string | null>> = Object.freeze({
+	chatero_read_only: ':read-only',
+	chatero_workspace: ':workspace',
+	chatero_full_access: null,
+});
+
+export function chateroCodexPermissionProfile(mode: SandboxMode): ChateroCodexPermissionProfileId {
+	switch (mode) {
+		case 'read-only': return 'chatero_read_only';
+		case 'workspace-write': return 'chatero_workspace';
+		case 'danger-full-access': return 'chatero_full_access';
+		default: return assertNever(mode);
+	}
+}
+
+export function chateroCodexLifecyclePermissions(mode: SandboxMode, runtimeWorkspaceRoots: readonly string[]): Readonly<{
+	permissions: ChateroCodexPermissionProfileId;
+	runtimeWorkspaceRoots: string[];
+}> {
+	const roots = runtimeWorkspaceRoots.map(root => requireAbsoluteNormalizedPath(root, 'runtime workspace root'));
+	if (roots.length === 0) {
+		throw new Error('Chatero Codex requires at least one runtime workspace root');
+	}
+	return Object.freeze({ permissions: chateroCodexPermissionProfile(mode), runtimeWorkspaceRoots: roots });
+}
+
+export function createChateroCodexPermissionContext(input: Readonly<{
+	codexHome: string;
+	trustedRuntimeRoots: readonly string[];
+}>): IChateroCodexPermissionContext {
+	const codexHome = canonicalPrivateDirectory(input.codexHome, 'CODEX_HOME');
+	const trustedRuntimeRoots = distinctPaths(input.trustedRuntimeRoots.map(root => canonicalDirectory(root, 'trusted runtime root')));
+	if (trustedRuntimeRoots.length === 0) {
+		throw new Error('Chatero Codex requires at least one trusted runtime root');
+	}
+	for (const runtimeRoot of trustedRuntimeRoots) {
+		if (pathsIntersect(runtimeRoot, codexHome)) {
+			throw new Error(`trusted runtime root overlaps CODEX_HOME: ${runtimeRoot}`);
+		}
+	}
+	const productProfiles = chateroCodexPermissionConfig({ codexHome, trustedRuntimeRoots });
+	const protectedObjects = captureProtectedObjectInventory([codexHome, ...trustedRuntimeRoots]);
+	return Object.freeze({
+		codexHome,
+		trustedRuntimeRoots: Object.freeze(trustedRuntimeRoots),
+		productProfiles,
+		launchOverrides: Object.freeze(chateroCodexPermissionOverrides({ codexHome, trustedRuntimeRoots })),
+		protectedObjects: Object.freeze(protectedObjects),
+	});
+}
+
+export function chateroCodexPermissionConfig(input: Readonly<{
+	codexHome: string;
+	trustedRuntimeRoots: readonly string[];
+}>): Readonly<Record<ChateroCodexPermissionProfileId, JsonObject>> {
+	const codexHome = requireAbsoluteNormalizedPath(input.codexHome, 'CODEX_HOME');
+	const trustedRuntimeRoots = distinctPaths(input.trustedRuntimeRoots.map(root => requireAbsoluteNormalizedPath(root, 'trusted runtime root')));
+	const protectedAbsolutePaths = distinctPaths([codexHome, ...trustedRuntimeRoots]);
+	const workspaceDeny = Object.fromEntries(CHATERO_RESERVED_WORKSPACE_SUBPATHS.map(path => [path, 'deny']));
+	const absoluteDeny = Object.fromEntries(protectedAbsolutePaths.map(path => [path, 'deny']));
+	const filesystem = (base?: Readonly<Record<string, unknown>>): JsonObject => ({
+		...(base ?? {}),
+		...absoluteDeny,
+		':workspace_roots': { ...workspaceDeny },
+	});
+	return deepFreeze({
+		chatero_read_only: {
+			extends: ':read-only',
+			filesystem: filesystem(),
+			network: { enabled: false },
+		},
+		chatero_workspace: {
+			extends: ':workspace',
+			filesystem: filesystem(),
+			network: { enabled: true, mode: 'full' },
+		},
+		chatero_full_access: {
+			filesystem: filesystem({ ':root': 'write' }),
+			network: { enabled: true, mode: 'full' },
+		},
+	});
+}
+
+export function chateroCodexPermissionOverrides(input: Readonly<{
+	codexHome: string;
+	trustedRuntimeRoots: readonly string[];
+}>): string[] {
+	const profiles = chateroCodexPermissionConfig(input);
+	return [
+		'default_permissions="chatero_read_only"',
+		...CHATERO_CODEX_PERMISSION_PROFILE_IDS.map(id => `permissions.${id}=${tomlInline(profiles[id])}`),
+	];
+}
+
+export async function chateroCodexPreflight(input: Readonly<{
+	reader: IChateroCodexPreflightReader;
+	cwd: string;
+	context: IChateroCodexPermissionContext;
+}>): Promise<Readonly<{ epoch: string }>> {
+	const cwd = requireAbsoluteNormalizedPath(input.cwd, 'Codex lifecycle cwd');
+	revalidateProtectedObjectInventory(input.context.protectedObjects);
+	for (const reserved of CHATERO_RESERVED_WORKSPACE_SUBPATHS) {
+		const reservedPath = resolve(cwd, reserved);
+		if (pathsIntersect(reservedPath, input.context.codexHome)) {
+			throw new Error(`CODEX_HOME overlaps a reserved Documentation path: ${reserved}`);
+		}
+		for (const runtimeRoot of input.context.trustedRuntimeRoots) {
+			if (pathsIntersect(reservedPath, runtimeRoot)) {
+				throw new Error(`trusted runtime overlaps a reserved Documentation path: ${reserved}`);
+			}
+		}
+	}
+	const [config, requirements, summaries] = await Promise.all([
+		input.reader.readConfig(cwd),
+		input.reader.readRequirements(),
+		input.reader.listPermissionProfiles(cwd),
+	]);
+	validateConfigurationLayers(config, input.context.productProfiles);
+	validateRequirements(requirements);
+	validateProfileSummaries(summaries);
+	return Object.freeze({ epoch: configurationEpoch(config, requirements, summaries) });
+}
+
+export function assertChateroActivePermissionProfile(
+	active: ActivePermissionProfile | null,
+	expected: ChateroCodexPermissionProfileId,
+	lifecycle: 'thread/start' | 'thread/fork' | 'thread/resume',
+): void {
+	if (!active || active.id !== expected || active.extends !== EXPECTED_PARENT[expected]) {
+		throw new Error(`${lifecycle} did not activate the required Chatero permission profile ${expected}`);
+	}
+}
+
+export function chateroPermissionRequestTouchesReserved(
+	fileSystem: AdditionalFileSystemPermissions | null,
+	runtimeWorkspaceRoots: readonly string[],
+): boolean {
+	if (!fileSystem) {
+		return false;
+	}
+	const roots = runtimeWorkspaceRoots.map(root => requireAbsoluteNormalizedPath(root, 'runtime workspace root'));
+	const reserved = roots.flatMap(root => CHATERO_RESERVED_WORKSPACE_SUBPATHS.map(path => resolve(root, path)));
+	const legacyPaths = [...(fileSystem.read ?? []), ...(fileSystem.write ?? [])];
+	if (legacyPaths.some(path => pathIntersectsAny(path, reserved))) {
+		return true;
+	}
+	for (const entry of fileSystem.entries ?? []) {
+		if (entry.access === 'deny') {
+			continue;
+		}
+		if (entry.path.type === 'glob_pattern') {
+			return true;
+		}
+		if (entry.path.type === 'path') {
+			if (pathIntersectsAny(entry.path.path, reserved)) {
+				return true;
+			}
+			continue;
+		}
+		const special = entry.path.value;
+		if (special.kind !== 'project_roots') {
+			return true;
+		}
+		if (!special.subpath || special.subpath === '.') {
+			return true;
+		}
+		if (CHATERO_RESERVED_WORKSPACE_SUBPATHS.some(path => relativePathsIntersect(path, special.subpath!))) {
+			return true;
+		}
+	}
+	return false;
+}
+
+function validateConfigurationLayers(
+	response: ConfigReadResponse,
+	expectedProfiles: Readonly<Record<ChateroCodexPermissionProfileId, JsonObject>>,
+): void {
+	if (!response.layers) {
+		throw new Error('Codex config/read omitted configuration layers');
+	}
+	const sessionLayers = response.layers.filter(layer => layer.name.type === 'sessionFlags');
+	if (sessionLayers.length !== 1) {
+		throw new Error('Codex configuration must contain exactly one sessionFlags layer');
+	}
+	for (const layer of response.layers) {
+		const config = asObject(layer.config, 'Codex configuration layer');
+		if (layer.name.type === 'sessionFlags') {
+			if (config.default_permissions !== 'chatero_read_only') {
+				throw new Error('Codex sessionFlags must default to chatero_read_only');
+			}
+			const permissions = asObject(config.permissions, 'Codex sessionFlags permissions');
+			if (!deepEqualJson(permissions, expectedProfiles)) {
+				throw new Error('Codex sessionFlags contain unexpected Chatero permission profiles');
+			}
+			continue;
+		}
+		if ('sandbox_mode' in config || 'sandbox_workspace_write' in config || 'sandbox' in config) {
+			throw new Error(`legacy Codex sandbox configuration is forbidden in ${layer.name.type} layer`);
+		}
+		const permissions = isObject(config.permissions) ? config.permissions : undefined;
+		if (permissions && CHATERO_CODEX_PERMISSION_PROFILE_IDS.some(id => id in permissions)) {
+			throw new Error(`Chatero permission profile shadowed by ${layer.name.type} layer`);
+		}
+	}
+}
+
+function validateRequirements(response: ConfigRequirementsReadResponse): void {
+	const requirements = response.requirements;
+	if (!requirements) {
+		return;
+	}
+	const allowed = requirements.allowedPermissionProfiles;
+	if (!allowed || CHATERO_CODEX_PERMISSION_PROFILE_IDS.some(id => allowed[id] !== true)) {
+		throw new Error('managed Codex requirements do not allow every Chatero permission profile');
+	}
+	if (!requirements.defaultPermissions || !CHATERO_CODEX_PERMISSION_PROFILE_IDS.includes(requirements.defaultPermissions as ChateroCodexPermissionProfileId) || allowed[requirements.defaultPermissions] !== true) {
+		throw new Error('managed Codex requirements do not select an allowed Chatero default profile');
+	}
+}
+
+function validateProfileSummaries(response: PermissionProfileListResponse): void {
+	if (response.nextCursor !== null) {
+		throw new Error('Codex permissionProfile/list unexpectedly required pagination');
+	}
+	for (const id of CHATERO_CODEX_PERMISSION_PROFILE_IDS) {
+		const matches = response.data.filter(summary => summary.id === id);
+		if (matches.length !== 1 || matches[0].allowed !== true) {
+			throw new Error(`Codex permission profile ${id} is missing or disallowed`);
+		}
+	}
+}
+
+function captureProtectedObjectInventory(roots: readonly string[]): IChateroProtectedObjectIdentity[] {
+	const result: IChateroProtectedObjectIdentity[] = [];
+	for (const root of distinctPaths(roots)) {
+		walkProtectedTree(root, root, result);
+	}
+	return result.sort((left, right) => Buffer.compare(Buffer.from(left.path), Buffer.from(right.path)));
+}
+
+function walkProtectedTree(path: string, root: string, result: IChateroProtectedObjectIdentity[]): void {
+	const lstat = fs.lstatSync(path);
+	if (lstat.isSymbolicLink()) {
+		const realPath = fs.realpathSync.native(path);
+		if (!isContainedRelative(relative(root, realPath))) {
+			throw new Error(`protected tree contains an escaping symbolic link: ${path}`);
+		}
+		result.push(Object.freeze({
+			path,
+			realPath,
+			dev: lstat.dev,
+			ino: lstat.ino,
+			mode: lstat.mode,
+			nlink: lstat.nlink,
+			kind: 'symlink',
+		}));
+		return;
+	}
+	if (!lstat.isDirectory() && !lstat.isFile()) {
+		throw new Error(`protected tree contains an unsupported object: ${path}`);
+	}
+	if (lstat.isFile() && lstat.nlink !== 1) {
+		throw new Error(`protected file has a hard-link alias: ${path}`);
+	}
+	result.push(Object.freeze({
+		path,
+		realPath: fs.realpathSync.native(path),
+		dev: lstat.dev,
+		ino: lstat.ino,
+		mode: lstat.mode,
+		nlink: lstat.nlink,
+		kind: lstat.isDirectory() ? 'directory' : 'file',
+	}));
+	if (!lstat.isDirectory()) {
+		return;
+	}
+	for (const child of fs.readdirSync(path).sort((left, right) => Buffer.compare(Buffer.from(left), Buffer.from(right)))) {
+		walkProtectedTree(join(path, child), root, result);
+	}
+}
+
+function revalidateProtectedObjectInventory(inventory: readonly IChateroProtectedObjectIdentity[]): void {
+	for (const expected of inventory) {
+		const current = fs.lstatSync(expected.path);
+		if ((current.isSymbolicLink() !== (expected.kind === 'symlink'))
+			|| current.dev !== expected.dev
+			|| current.ino !== expected.ino
+			|| current.nlink !== expected.nlink
+			|| fs.realpathSync.native(expected.path) !== expected.realPath) {
+			throw new Error(`protected Codex object identity changed: ${expected.path}`);
+		}
+		if (expected.kind === 'file' && current.nlink !== 1) {
+			throw new Error(`protected Codex file acquired a hard-link alias: ${expected.path}`);
+		}
+	}
+}
+
+function canonicalPrivateDirectory(path: string, label: string): string {
+	const canonical = canonicalDirectory(path, label);
+	const stat = fs.statSync(canonical);
+	if ((stat.mode & 0o077) !== 0 || (typeof process.getuid === 'function' && stat.uid !== process.getuid())) {
+		throw new Error(`${label} must be owner-private`);
+	}
+	return canonical;
+}
+
+function canonicalDirectory(path: string, label: string): string {
+	const normalized = requireAbsoluteNormalizedPath(path, label);
+	const lstat = fs.lstatSync(normalized);
+	if (lstat.isSymbolicLink() || !lstat.isDirectory()) {
+		throw new Error(`${label} must be a real directory: ${normalized}`);
+	}
+	const real = fs.realpathSync.native(normalized);
+	if (filesystemPathKey(real) !== filesystemPathKey(normalized)) {
+		throw new Error(`${label} must not traverse symbolic links: ${normalized}`);
+	}
+	if ((lstat.mode & 0o022) !== 0) {
+		throw new Error(`${label} must not be group/world writable: ${normalized}`);
+	}
+	return real;
+}
+
+function requireAbsoluteNormalizedPath(path: string, label: string): string {
+	if (!path || path.includes('\0') || !isAbsolute(path)) {
+		throw new Error(`${label} must be a non-empty absolute path`);
+	}
+	const normalized = normalize(path);
+	if (normalized === sep || normalized.endsWith(sep + '..')) {
+		throw new Error(`${label} is too broad: ${path}`);
+	}
+	return normalized;
+}
+
+function distinctPaths(paths: readonly string[]): string[] {
+	const values = new Map<string, string>();
+	for (const path of paths) {
+		const key = filesystemPathKey(path);
+		if (values.has(key)) {
+			throw new Error(`duplicate or aliased protected path: ${path}`);
+		}
+		values.set(key, path);
+	}
+	return [...values.values()].sort((left, right) => Buffer.compare(Buffer.from(left), Buffer.from(right)));
+}
+
+function pathsIntersect(left: string, right: string): boolean {
+	const fromLeft = relative(left, right);
+	const fromRight = relative(right, left);
+	return isContainedRelative(fromLeft) || isContainedRelative(fromRight);
+}
+
+function pathIntersectsAny(path: string, reserved: readonly string[]): boolean {
+	if (!isAbsolute(path)) {
+		return true;
+	}
+	const normalized = normalize(path);
+	return reserved.some(candidate => pathsIntersect(normalized, candidate));
+}
+
+function relativePathsIntersect(left: string, right: string): boolean {
+	const leftParts = normalizeRelative(left);
+	const rightParts = normalizeRelative(right);
+	return startsWithParts(leftParts, rightParts) || startsWithParts(rightParts, leftParts);
+}
+
+function normalizeRelative(path: string): string[] {
+	if (!path || path.includes('\0') || isAbsolute(path)) {
+		return [];
+	}
+	const parts = path.replaceAll('\\', '/').split('/').filter(part => part && part !== '.');
+	if (parts.some(part => part === '..')) {
+		return [];
+	}
+	return parts;
+}
+
+function startsWithParts(value: readonly string[], prefix: readonly string[]): boolean {
+	return prefix.length <= value.length && prefix.every((part, index) => filesystemPathKey(part) === filesystemPathKey(value[index]));
+}
+
+function isContainedRelative(path: string): boolean {
+	return path === '' || (!path.startsWith(`..${sep}`) && path !== '..' && !isAbsolute(path));
+}
+
+function filesystemPathKey(path: string): string {
+	return process.platform === 'linux' ? path : path.toLowerCase();
+}
+
+function configurationEpoch(config: ConfigReadResponse, requirements: ConfigRequirementsReadResponse, profiles: PermissionProfileListResponse): string {
+	return JSON.stringify({
+		layers: config.layers?.map(layer => ({ name: layer.name, version: layer.version })) ?? null,
+		requirements: requirements.requirements,
+		profiles: profiles.data.map(profile => ({ id: profile.id, allowed: profile.allowed })).sort((left, right) => Buffer.compare(Buffer.from(left.id), Buffer.from(right.id))),
+	});
+}
+
+function tomlInline(value: unknown): string {
+	if (typeof value === 'string') {
+		return JSON.stringify(value);
+	}
+	if (typeof value === 'boolean' || typeof value === 'number') {
+		return String(value);
+	}
+	if (!isObject(value)) {
+		throw new Error('unsupported Chatero permission profile value');
+	}
+	return `{${Object.entries(value).map(([key, entry]) => `${JSON.stringify(key)}=${tomlInline(entry)}`).join(',')}}`;
+}
+
+function asObject(value: unknown, label: string): JsonObject {
+	if (!isObject(value)) {
+		throw new Error(`${label} must be an object`);
+	}
+	return value;
+}
+
+function isObject(value: unknown): value is JsonObject {
+	return value !== null && typeof value === 'object' && !Array.isArray(value);
+}
+
+function deepEqualJson(left: unknown, right: unknown): boolean {
+	return canonicalJson(left) === canonicalJson(right);
+}
+
+function canonicalJson(value: unknown): string {
+	if (Array.isArray(value)) {
+		return `[${value.map(canonicalJson).join(',')}]`;
+	}
+	if (isObject(value)) {
+		return `{${Object.keys(value).sort((left, right) => Buffer.compare(Buffer.from(left), Buffer.from(right))).map(key => `${JSON.stringify(key)}:${canonicalJson(value[key])}`).join(',')}}`;
+	}
+	return JSON.stringify(value);
+}
+
+function deepFreeze<T>(value: T): T {
+	if (value && typeof value === 'object') {
+		Object.freeze(value);
+		for (const entry of Object.values(value as Record<string, unknown>)) {
+			deepFreeze(entry);
+		}
+	}
+	return value;
+}
+
+function assertNever(value: never): never {
+	throw new Error(`unsupported Codex sandbox mode: ${String(value)}`);
+}
