+		// a local override at runtime, so a Finder launch works offline after the
+		// application has been built and installed.
+		const bundledCodexSdk = gulp.src([
+			'node_modules/@openai/codex/**',
+			`node_modules/@openai/codex-${platform}-${arch}/**`,
+		], { base: '.', dot: true, allowEmpty: false })
