+				file.dirname = file.dirname!.replace(/^node_modules/, 'agent-sdk/codex/node_modules');
+			}))
+			.pipe(util.setExecutableBit([
+				'**/vendor/**/bin/codex',
+				'**/vendor/**/codex-path/rg',
+				'**/vendor/**/zsh/bin/zsh',
+			]));
+
 		const sourceFilterPattern = stripSourceMapsInPackagingTasks
 			? ['**', '!**/*.{js,css}.map']
 			: ['**'];
